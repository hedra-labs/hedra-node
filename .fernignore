# Files Fern must NOT overwrite when it regenerates this SDK (via PR from the
# hedra-labs/fern-config repo). See https://buildwithfern.com/learn/sdks/capabilities/customize-files

# npm package name (hedra-node) + metadata (author/license/description)
package.json

# README install/imports use the hedra-node package name
README.md

# Hand-maintained docs / history
LICENSE
CHANGELOG.md

# SDK version constant (bumped by hand at release time)
src/version.ts

# Dependency lockfile. Fern regenerates it on every SDK regeneration, which
# silently reverts anything committed here — it already ate a merged fast-uri
# security bump once (1dfc681, reverted by 11519b2). Hand-owned instead, like
# poetry.lock in hedra-python and Cargo.lock in hedra-cli. Trade-off: if Fern
# ever changes a dependency, `pnpm install --frozen-lockfile` fails loudly in
# CI and publish-npm rather than silently dropping the fix.
pnpm-lock.yaml

# CI + publishing are hand-maintained (Fern doesn't manage workflows here)
.github/

# Lint config is scoped to hand-maintained files (generated code is excluded);
# Fern's default biome.json would undo that scoping.
biome.json
.fern/replay.lock
.fern/replay.yml
.gitattributes
